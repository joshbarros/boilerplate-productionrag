# ─── LLM Providers ───
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Generation routing ───
# Default provider: anthropic | openai | ollama
DEFAULT_PROVIDER=anthropic
# Anthropic models (haiku = cheap default, sonnet = escalation)
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ESCALATION_MODEL=claude-sonnet-4-6
# OpenAI alt
OPENAI_DEFAULT_MODEL=gpt-4o-mini
# Ollama fallback (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ─── Embeddings ───
# Provider: openai | local
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3

# ─── Retrieval ───
RETRIEVAL_MODE=hybrid
TOP_K=8
RRF_K=60
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ─── Vector backends ───
PGVECTOR_CONNECTION=postgresql+psycopg://ragcore:ragcore@localhost:5432/ragcore
QDRANT_URL=http://localhost:6333
QDRANT_BENCH_ENABLED=false

# ─── Budget ───
DAILY_BUDGET_USD=5.00
QUERY_BUDGET_USD=0.10
CACHE_TTL_SECONDS=3600

# ─── Security ───
API_TOKEN=changeme
RATE_LIMIT_PER_MINUTE=30

# ─── Feature flags ───
LOCAL_LLM_ENABLED=true
OCR_ENABLED=true

# ─── Observability ───
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ragcore

# ─── Server ───
API_HOST=0.0.0.0
API_PORT=8800
MCP_PORT=8801
