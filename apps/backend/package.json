{
  "name": "@production-rag/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Python RAG backend — FastAPI + FastMCP",
  "scripts": {
    "dev": "uv run uvicorn ragcore.api.app:app --reload --port 8800",
    "mcp": "uv run python -m ragcore.mcp_server.app",
    "api": "uv run uvicorn ragcore.api.app:app --port 8800",
    "lint": "uv run ruff check src/ tests/",
    "test": "uv run pytest --ignore=tests/e2e_test.py --ignore=tests/test_phase5_ingestion.py -q",
    "test:eval": "EVAL_TEST=1 uv run pytest tests/test_phase7_evals.py::test_phase7_live_eval_suite -v -s",
    "test:all": "uv run pytest -q"
  }
}
